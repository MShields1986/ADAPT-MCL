<?xml version="1.0"?>
<launch>
  <arg name="launch_rviz" default="true"/>
  <arg name="output_dir"  default="/output/results"/>
  <arg name="vpr_candidates_file" default="/data/mapping/vpr_candidates.txt"/>

  <include file="$(find lilocbench_ros)/launch/localize.launch">
    <arg name="sequence"              value="mapping"/>
    <arg name="bag"                   value="/data/mapping/mapping_no_cams.bag"/>
    <arg name="map"                   value="/data/map_office/map_office.yaml"/>
    <arg name="output_dir"            value="$(arg output_dir)"/>
    <!-- Disable scan-match seed — using VPR candidates instead -->
    <arg name="use_scan_match_seed"   value="false"/>
    <arg name="use_cpd_rerank"        value="false"/>
    <!-- Use VPR-appropriate init spread (wider than tracking, narrower than global) -->
    <arg name="init_random_fraction"  value="0.0"/>
    <arg name="kld_max_particles"     value="10000"/>
  </include>

  <!-- Override: set the VPR candidates file on the localizer node -->
  <param name="/localizer_node/vpr_candidates_file" value="$(arg vpr_candidates_file)"/>
  <!-- VPR candidates: position uncertain by ~2m, heading completely unknown -->
  <param name="/localizer_node/init_spread_pos_m"   value="2.0"/>
  <param name="/localizer_node/n_particles"         value="5000"/>

  <group if="$(arg launch_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" required="false" output="screen"
          args="-d $(find lilocbench_ros)/config/default.rviz"/>
  </group>
</launch>
